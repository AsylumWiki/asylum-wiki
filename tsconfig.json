{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "esnext",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "node_modules/",
    ".vitepress/dist/",
    ".vitepress/cache/"
  ],
  "include": [
    "**/*",
    ".vitepress/**/*"
  ]
}
